---
const { title } = Astro.props;
const description = "Starter kit with Astro and Tailwind CSS";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main class="flex">
      <aside class="border min-h-screen p-4">
        <article class="w-full bg-red-300">
          <a class="w-full flex" href="#">instalacion</a>
        </article>
      </aside>
      <slot />
    </main>
  </body>
</html>
