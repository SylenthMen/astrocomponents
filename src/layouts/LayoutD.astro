---
const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Mi Documentación</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-gray-100 text-gray-900 flex flex-col min-h-screen">
    <header class="bg-blue-600 text-white p-4 shadow-md">
      <div class="container mx-auto">
        <h1 class="text-2xl font-bold">Mi Documentación</h1>
      </div>
    </header>

    <div class="flex-grow container mx-auto mt-4 flex">
      <aside class="w-64 pr-4">
        <nav class="space-y-2">
          <a href="/" class="block py-2 px-4 rounded hover:bg-blue-100"
            >Inicio</a
          >
          <a href="/guia" class="block py-2 px-4 rounded hover:bg-blue-100"
            >Guía</a
          >
          <a href="/api" class="block py-2 px-4 rounded hover:bg-blue-100"
            >API</a
          >
          <a href="/ejemplos" class="block py-2 px-4 rounded hover:bg-blue-100"
            >Ejemplos</a
          >
        </nav>
      </aside>

      <main class="flex-grow bg-white p-6 shadow-md rounded-lg">
        <h2 class="text-3xl font-bold mb-4">{title}</h2>
        <slot />
      </main>
    </div>

    <footer class="bg-gray-200 text-center p-4 mt-8">
      <p>&copy; 2023 Mi Proyecto. Todos los derechos reservados.</p>
    </footer>
  </body>
</html>
