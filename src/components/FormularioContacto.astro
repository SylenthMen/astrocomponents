---
const { titleStyle = "text-white text-3xl font-bold mb-6 text-center" } =
  Astro.props;
const { titleFormulario = "Contactanos" } = Astro.props;
const { styleFormulario = "bg-white" } = Astro.props;
const { colorLabel = "text-white" } = Astro.props;
const {
  styleInput = "border-b border-neutral-800 bg-neutral-800 text-white focus:outline-none px-3 py-2",
} = Astro.props;
---

<div class=`rounded-2xl shadow-2xl p-8 w-full max-w-md ${styleFormulario}`>
  <h2 class=`${titleStyle}`>
    {titleFormulario}
  </h2>
  <form class="space-y-6">
    <div class="space-y-2">
      <label for="name" class=`text-sm font-medium ${colorLabel}`>Nombre</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class=`w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 ease-in-out ${styleInput}`
        placeholder="Tu nombre"
      />
    </div>
    <div class="space-y-2">
      <label for="email" class=`text-sm font-medium ${colorLabel}`>Email</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class=`w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 ease-in-out ${styleInput}`
        placeholder="tu@email.com"
      />
    </div>
    <div class="space-y-2">
      <label for="subject" class=`text-sm font-medium ${colorLabel}`
        >Asunto</label
      >
      <input
        type="text"
        id="subject"
        name="subject"
        required
        class=`w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 ease-in-out ${styleInput}`
        placeholder="Asunto de tu mensaje"
      />
    </div>
    <div class="space-y-2">
      <label for="message" class=`text-sm font-medium ${colorLabel}`
        >Mensaje</label
      >
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        class=`w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 ease-in-ou resize-none ${styleInput}`
        placeholder="Tu mensaje aquí..."></textarea>
    </div>
    <div>
      <slot />
    </div>
  </form>
</div>
